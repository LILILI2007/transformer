{
  "version": 1,
  "id_pattern": "[A-Za-z0-9_.-]+",
  "max_depth": 12,
  "known_languages": ["de", "en", "es", "fr", "hu", "it", "ja", "ko", "pt", "ru", "tr", "zh"],
  "visible_fields": ["DisplayName", "Description", "Text", "Title", "Dialogue", "Question", "Objective", "CompletionMessage", "DisplayDescription", "DisplayTitle"],
  "name_assets": ["Data/SpecialOrders", "Data/Buildings"],
  "assets": [
    {"name": "Characters/Dialogue/", "mode": "all"},
    {"name": "Strings/", "mode": "all"},
    {"name": "Data/mail", "mode": "all"},
    {"name": "Data/Events/", "mode": "all"},
    {"name": "Data/Quests", "mode": "all"},
    {"name": "Data/Objects", "mode": "fields"},
    {"name": "Data/BigCraftables", "mode": "fields"},
    {"name": "Data/Weapons", "mode": "fields"},
    {"name": "Data/Furniture", "mode": "fields"},
    {"name": "Data/Buildings", "mode": "fields"},
    {"name": "Data/Characters", "mode": "fields"},
    {"name": "Data/SpecialOrders", "mode": "fields"},
    {"name": "Data/Movies", "mode": "fields"},
    {"name": "Data/Festivals", "mode": "fields"},
    {"name": "Data/NPCGiftTastes", "mode": "all"},
    {"name": "Data/EngagementDialogue", "mode": "all"},
    {"name": "Data/ExtraDialogue", "mode": "all"},
    {"name": "Data/SecretNotes", "mode": "all"},
    {"name": "Data/WorldMap", "mode": "paths",
      "paths": [["*", "MapAreas", "*", "ScrollText"], ["*", "MapAreas", "*", "Tooltips", "*", "Text"]],
      "id_lists": [["*", "MapAreas"], ["*", "MapAreas", "*", "Tooltips"]]},
    {"name": "Data/Minecarts", "mode": "paths",
      "paths": [["*", "LockedMessage"], ["*", "ChooseDestinationMessage"], ["*", "BuyTicketMessage"], ["*", "Destinations", "*", "DisplayName"], ["*", "Destinations", "*", "BuyTicketMessage"]],
      "id_lists": [["*", "Destinations"]]}
  ],
  "i18n_pattern": "\\{\\{\\s*i18n\\s*:\\s*([^{}|]+?)\\s*\\}\\}",
  "localized_pattern": "\\[LocalizedText\\s+(Strings[/\\\\][A-Za-z0-9_./\\\\-]+:[A-Za-z0-9_.-]+)\\]"
}
